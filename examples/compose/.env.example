# Copy to a private .env alongside the selected deployment Compose; chmod 600 .env
# Used by examples/compose/remote-clamd-postgres.yaml
CLAMAV_WEB_BIND=127.0.0.1
CLAMAV_HOST=clamd.example.test
CLAMAV_PORT=3310
SPRING_DATASOURCE_URL=jdbc:postgresql://database.example.test:5432/clamav
SPRING_DATASOURCE_USERNAME=clamav
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_PRIVATE_DATABASE_PASSWORD
CLAMAV_REST_URL=
CLAMAV_REST_API_KEY=
# Packaged default; use none only to opt out for a direct-access deployment.
SERVER_FORWARD_HEADERS_STRATEGY=framework

# Webhook delivery policy (startup settings; URL/enable remain under Configuration Center > Notifications)
CLAMAV_WEBHOOK_CONNECT_TIMEOUT=5s
CLAMAV_WEBHOOK_READ_TIMEOUT=10s
CLAMAV_WEBHOOK_DNS_TIMEOUT=5s
CLAMAV_WEBHOOK_DELIVERY_TIMEOUT=20s
CLAMAV_WEBHOOK_WORKERS=2
CLAMAV_WEBHOOK_QUEUE_CAPACITY=100
CLAMAV_WEBHOOK_ALLOW_PRIVATE_ADDRESSES=false
