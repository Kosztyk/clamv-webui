# Scrape only through a trusted management network or host-local listener.
# This token is a standalone scrape credential; it is NOT a ClamAV browser/admin password.
global:
  scrape_interval: 30s
  evaluation_interval: 30s
rule_files:
  - /etc/prometheus/rules/clamav-alerts.yml
scrape_configs:
  - job_name: clamav-webui
    metrics_path: /actuator/prometheus
    scheme: http
    static_configs:
      - targets: ["127.0.0.1:9091"]  # Prometheus on same Docker host; for a container use clamav-web-client:9091 on a private network
    authorization:
      type: Bearer
      credentials_file: /etc/prometheus/secrets/clamav_metrics_token
    scrape_timeout: 10s
