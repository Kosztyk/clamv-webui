<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.9</version>
		<relativePath />
	</parent>

	<groupId>info.trizub.clamav</groupId>
	<artifactId>clamav-web-client</artifactId>
	<version>2.0.0</version>
	<packaging>jar</packaging>
	<name>clamav-web-client</name>
	<description>Web client for ClamAV antivirus service</description>

	<licenses>
		<license>
			<name>GNU LESSER GENERAL PUBLIC LICENSE Version 2.1</name>
			<url>https://www.gnu.org/licenses/old-licenses/lgpl-2.1.txt</url>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Ruslan Huzii</name>
			<url>https://github.com/rguziy</url>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:git@github.com:rguziy/clamav-web-client.git</connection>
		<developerConnection>scm:git:git@github.com:rguziy/clamav-web-client.git</developerConnection>
		<url>git@github.com:rguziy/clamav-web-client.git</url>
		<tag>HEAD</tag>
	</scm>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<java.version>17</java.version>
		<!-- Surefire/Failsafe append the test-only Mockito agent to optional caller/coverage arguments. -->
		<argLine />
		<!-- Boot 4.0.9 manages the fixes listed in docs/SECURITY_DEPENDENCY_UPDATE.md. -->
		<postgresql.version>42.7.13</postgresql.version>
		<!-- Override Boot's older HTTP stack: fixes CVE-2026-64607/54399/54428. -->
		<httpclient5.version>5.6.5</httpclient5.version>
		<httpcore5.version>5.4.4</httpcore5.version>
		<!-- Current 3.5 maintenance fixes; retain the existing JDBC connection behavior. -->
		<mariadb.version>3.5.11</mariadb.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.postgresql</groupId>
				<artifactId>postgresql</artifactId>
				<version>${postgresql.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- Managed by Boot; the webhook transport validates the DNS addresses it actually connects to. -->
		<dependency>
			<groupId>org.apache.httpcomponents.client5</groupId>
			<artifactId>httpclient5</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket</artifactId>
		</dependency>
		<!-- Preserve the application's Jackson 2 JSON and persisted settings contracts. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-jackson2</artifactId>
		</dependency>

		<!-- Security + RBAC -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.thymeleaf.extras</groupId>
			<artifactId>thymeleaf-extras-springsecurity6</artifactId>
		</dependency>

        <!-- Optional Phase 3 enterprise identity providers (disabled by default). -->
        <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-ldap</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security-oauth2-client</artifactId></dependency>

		<!-- Persistence for jobs/audit/users -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-h2console</artifactId></dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<version>${postgresql.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Phase 2: versioned, vendor-specific schema migrations. Spring Boot manages Flyway versions. -->
		<dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-flyway</artifactId></dependency>
		<dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
		<dependency><groupId>org.flywaydb</groupId><artifactId>flyway-mysql</artifactId></dependency>
		<dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><scope>runtime</scope></dependency>
		<dependency><groupId>org.mariadb.jdbc</groupId><artifactId>mariadb-java-client</artifactId><scope>runtime</scope></dependency>

		<!-- Testcontainers: run the cross-vendor integration profile on a Docker-enabled CI runner. -->
		<dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-junit-jupiter</artifactId><scope>test</scope></dependency>
		<dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-postgresql</artifactId><scope>test</scope></dependency>
		<dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-mysql</artifactId><scope>test</scope></dependency>
		<dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-mariadb</artifactId><scope>test</scope></dependency>

		<!-- Validation -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Metrics/health -->
        <dependency><groupId>io.micrometer</groupId><artifactId>micrometer-registry-prometheus</artifactId></dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- SMTP is enabled by runtime configuration; keep its classes in the executable JAR. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<!-- ClamAV Client Library from https://github.com/cdarras/clamav-client -->
		<dependency>
			<groupId>xyz.capybara</groupId>
			<artifactId>clamav-client</artifactId>
			<version>2.1.2</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa-test</artifactId><scope>test</scope></dependency>
		<dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator-test</artifactId><scope>test</scope></dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<resources>
			<resource><directory>src/main/resources</directory></resource>
			<resource><directory>dashboards</directory><targetPath>monitoring</targetPath>
				<includes><include>grafana-clamav-webui.json</include><include>clamav-alerts.yml</include></includes>
			</resource>
		</resources>
		<plugins>
			<!-- Resolve the managed Mockito JAR portably, including inside the Docker build. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions><execution>
					<id>test-agent-path</id>
					<phase>initialize</phase>
					<goals><goal>properties</goal></goals>
				</execution></executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>@{argLine} -javaagent:"${org.mockito:mockito-core:jar}"</argLine>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
                <executions><execution><goals><goal>build-info</goal></goals></execution></executions>
			</plugin>
			<plugin>
				<artifactId>maven-resources-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-resources</id>
						<phase>validate</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${basedir}/target/conf</outputDirectory>
							<resources>
								<resource>
									<!-- Never copy/filter mounted credentials, CA/truststores or other runtime files. -->
									<directory>conf</directory>
									<filtering>false</filtering>
									<includes>
										<include>clamav-web-client.properties.example</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<profile>
			<id>db-integration</id>
			<build><plugins><plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration><argLine>@{argLine} -javaagent:"${org.mockito:mockito-core:jar}"</argLine></configuration>
				<executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
			</plugin></plugins></build>
		</profile>
	</profiles>
</project>
