# Copy to .env and set the complete immutable digest from the ClamAV image you have validated.
# Do not paste the literal placeholder into a production configuration.
CLAMAV_BASE_IMAGE=clamav/clamav@sha256:REPLACE_WITH_VERIFIED_DIGEST
# Local-host TLS reverse proxy (change only if your network architecture requires it).
CLAMAV_WEB_BIND_ADDRESS=127.0.0.1
