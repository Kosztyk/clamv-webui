# The Web UI image tag is local by default; it is not the application version.
# Versioned release artifacts derive their version from pom.xml.
# CLAMAV_WEBUI_IMAGE_TAG=local

# Copy to .env and override only with an independently verified immutable image digest.
# Do not paste the literal placeholder into a production configuration.
CLAMAV_BASE_IMAGE=clamav/clamav:1.4.7@sha256:b7357e2c1c59480628839df301b0d27923561389b36cf341911e1dd9e02cdd05
# Local-host TLS reverse proxy (change only if your network architecture requires it).
CLAMAV_WEB_BIND_ADDRESS=127.0.0.1