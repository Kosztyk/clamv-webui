# Maven / Java build output
target/
*.jar
*.war
*.ear

# Runtime state - do not commit local DBs, uploads, or quarantined files
data/
*.mv.db
*.trace.db
*.lock.db

# Runtime configuration is always local and may contain credentials.
# Keep ONLY the credential-free template in source control.
/conf/*
!/conf/clamav-web-client.properties.example
/conf/clamav-web-client.properties
/conf/integrations.properties
.env

# IDE / OS files
.idea/
.vscode/
*.iml
.DS_Store
__pycache__/
*.pyc
/cli/dist/
/artifacts/
