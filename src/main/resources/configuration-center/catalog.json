  "sections": [
    {
      "id": "clamd",
      "category": "Connections",
      "title": "Managed ClamAV scans",
      "icon": "shield-alt",
      "enableKey": "center.clamd.enabled",
      "enabledValue": "true",
      "disabledValue": "false",
      "description": "Configure the default engine here. Manage additional engines on Endpoints. Socket and shared scan paths must already be mounted.",
      "link": "/admin/endpoints"
    },
    {
      "id": "rest",
      "category": "Connections",
      "title": "External REST scanner",
      "icon": "plug",
      "enableKey": "clamav.rest.enabled",
      "enabledValue": "true",
      "disabledValue": "false",
      "description": "Separate external scanner for API Scan and API Reports. Its jobs and webhooks are independent.",
      "link": ""
    },
    {
      "id": "database",
      "category": "Connections",
      "title": "Database & persistence",
      "icon": "database",
      "enableKey": "",
      "enabledValue": "true",
      "disabledValue": "false",
      "description": "Use H2 for a single-instance quickstart, or an existing PostgreSQL, MySQL or MariaDB database. Selecting a different database does not migrate users or jobs.",
      "link": ""
    },
    {
      "id": "scanning",
      "category": "Scanning",
      "title": "Scan policy & upload storage",
      "icon": "file-upload",
      "enableKey": "",
      "enabledValue": "true",
      "disabledValue": "false",
      "description": "Paths refer to this container. Docker mounts and host permissions remain deployment responsibilities.",
      "link": ""
    },
    {
      "id": "quarantine",
      "category": "Scanning",
      "title": "Quarantine",
      "icon": "biohazard",
      "enableKey": "app.quarantine.enabled",
      "enabledValue": "true",
      "disabledValue": "false",
      "description": "Moving original files requires write access to their parent directory. Keep quarantine outside watched roots.",
      "link": ""
    },
    {
      "id": "watch",
      "category": "Scanning",
      "title": "Watched folders",
      "icon": "folder-open",
      "enableKey": "app.watch.enabled",
      "enabledValue": "true",
      "disabledValue": "false",
      "description": "Configure individual watched directories on the existing Watch Directories page.",
      "link": "/admin/watch"
    },
    {
      "id": "local",
      "category": "Identity & API",
      "title": "Local recovery administrator",
      "icon": "user-shield",
      "enableKey": "",
      "enabledValue": "true",
      "disabledValue": "false",
      "description": "An enabled local administrator is always retained. Manage local accounts and passwords on Users.",
      "link": "/admin/users"
    },
    {
      "id": "ldap",
      "category": "Identity & API",
      "title": "LDAP / Active Directory",
      "icon": "address-book",
      "enableKey": "clamav.identity.ldap.enabled",
      "enabledValue": "true",
      "disabledValue": "false",
      "description": "LDAP / Active Directory uses verified LDAPS or StartTLS. Test connection validates transport and manager bind without saving. Group filters, membership/name attributes, nesting, timeouts, referrals and role maps use the same runtime validation. Changes apply after restart; keep an enabled local recovery administrator.",
      "link": ""
    },
    {
      "id": "oidc",
      "category": "Identity & API",
      "title": "OpenID Connect / SSO",
      "icon": "key",
      "enableKey": "clamav.identity.oidc.enabled",
      "enabledValue": "true",
      "disabledValue": "false",
      "description": "OIDC / SSO requires HTTPS issuer discovery and a confidential client. State, nonce and explicit group-to-role mapping remain enforced. Review and restart to apply saved settings; local login remains available.",
      "link": ""
    },
    {
      "id": "api",
      "category": "Identity & API",
      "title": "API tokens, CLI & MCP",
      "icon": "terminal",
      "enableKey": "",
      "enabledValue": "true",
      "disabledValue": "false",
      "description": "Manage scoped tokens on API Tokens. CLI/MCP clients run separately and use this application's HTTPS address.",
      "link": "/admin/api-tokens"
    },
    {
      "id": "webhook",
      "category": "Notifications",
      "title": "Webhook notifications",
      "icon": "bell",
      "enableKey": "app.webhook.enabled",
      "enabledValue": "true",
      "disabledValue": "false",
      "description": "Managed scan completion notifications for generic HTTP(S) or Discord receivers. Delivery is best effort with no durable retry queue.",
      "link": ""
    },
    {
      "id": "proxy",
      "category": "Network",
      "title": "Reverse proxy & session security",
      "icon": "network-wired",
      "enableKey": "server.forward-headers-strategy",
      "enabledValue": "native",
      "disabledValue": "none",
      "description": "Forwarded headers are ignored by default. For a TLS proxy, select native and allow only the actual proxy addresses below. The proxy must replace incoming forwarded headers. Session limits apply in direct and proxy mode.",
      "link": ""
    },
    {
      "id": "trust",
      "category": "Network",
      "title": "Private CA trust",
      "icon": "certificate",
      "enableKey": "",
      "enabledValue": "true",
      "disabledValue": "false",
      "description": "Mount an existing Java truststore first. This page cannot create a host mount or disable certificate verification.",
      "link": ""
    },
    {
      "id": "metrics",
      "category": "Monitoring",
      "title": "Prometheus & Grafana",
      "icon": "chart-line",
      "enableKey": "clamav.metrics.enabled",
      "enabledValue": "true",
      "disabledValue": "false",
      "description": "Scraping requires its separate token. Import the supplied Grafana dashboard; its panels consume real daemon and job samples.",
      "link": "/admin/integrations"
    },
    {
      "id": "clamdtop",
      "category": "Monitoring",
      "title": "Native ClamdTop sessions",
      "icon": "terminal",
      "enableKey": "",
      "enabledValue": "true",
      "disabledValue": "false",
      "description": "Native terminal sessions are limited to two per user and eight per instance. Visible tabs send a heartbeat every 30 seconds; inactive or hidden sessions are closed when the idle limit expires (plus up to 30 seconds for reaping).",
      "link": "/clamdtop"
    },
    {
      "id": "observer",
      "category": "Monitoring",
      "title": "Mounted daemon configuration",
      "icon": "sliders-h",
      "enableKey": "center.observer.enabled",
      "enabledValue": "true",
      "disabledValue": "false",
      "description": "Inspect mounted clamd.conf/freshclam.conf without writing files or reloading ClamD.",
      "link": "/admin/configuration"
    },
    {
      "id": "system",
      "category": "System",
      "title": "Preferences & recovery",
      "icon": "cog",
      "enableKey": "",
      "enabledValue": "true",
      "disabledValue": "false",
      "description": "Theme/language defaults apply to browsers without a saved preference. Recovery works independently of the application database.",
      "link": ""
    },
    {
      "id": "retention",
      "category": "Scanning",
      "title": "Upload cleanup and history",
      "icon": "trash",
      "enableKey": "",
      "enabledValue": "true",
      "disabledValue": "false",
      "description": "Remove completed uploads and expired temporary files. Optional job/audit retention is disabled until you choose a duration.",
      "link": ""
    }
  ],
